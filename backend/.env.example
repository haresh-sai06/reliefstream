# ReliefStream — LLM extractor configuration
# Any OpenAI-compatible endpoint works.

# ─── Option A: Ollama (fully local, free, no key) ──────────────
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# ─── Option B: OpenRouter free-tier ────────────────────────────
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-YOUR_KEY_HERE
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ─── Option C: Groq ────────────────────────────────────────────
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_YOUR_KEY_HERE
# LLM_MODEL=llama-3.3-70b-versatile

# ─── Option D: Gemini via OpenAI-compat proxy ──────────────────
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=YOUR_GEMINI_KEY
# LLM_MODEL=gemini-2.5-flash

# ─── Database ──────────────────────────────────────────────────
DATABASE_PATH=reliefstream.db

# ─── CORS ──────────────────────────────────────────────────────
# Frontend origin (adjust if serving elsewhere)
ALLOW_ORIGIN=http://localhost:8080
